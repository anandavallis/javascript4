     var num1 = 20;
      var num2 = 10;

function compareNumber(num1, num2) {
    if (num1 >= num2) {
        console.log(num1 + " is greater than " + num2);
    } 
    else if (num1 < num2) {
        console.log(num1 + " is less than " + num2);
    } 
    else {
        console.log(num1 + " is equal to " + num2);
    }
}
compareNumber(num1, num2);

    
